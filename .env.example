# ── Core ──────────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True

# Comma-separated list — add your domain in production
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL only) ────────────────────────────────────────────────
# Option A: individual vars (local dev / docker-compose)
DB_NAME=smartseason
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Option B: single DATABASE_URL (Render / Railway / Heroku)
# If set, this takes priority over the DB_* vars above.
# DATABASE_URL=postgres://user:password@host:5432/smartseason
